# EventRoute Environment Variables (Optional)
# If left blank, the app functions with full local persistence and mock AI/routing fallbacks.

# Supabase Configuration (Optional for remote PostgreSQL event sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Key (Optional for live multimodal poster vision extraction)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
